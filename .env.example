# Lovable Cloud / Supabase (backend) — rellena con los valores de tu proyecto.
# NO comitees el .env real: está en .gitignore.
# La publishable key (sb_publishable_...) o la anon key (eyJ...) son públicas: van en el frontend.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# reCAPTCHA v3 (opcional en desarrollo).
# Solo la site key va aquí: es pública por diseño. La secret key se guarda como secreto
# de Edge Functions (RECAPTCHA_SECRET_KEY) y nunca en el frontend.
# Sin esta variable el formulario de contacto sigue funcionando, sin verificación.
VITE_RECAPTCHA_SITE_KEY=
