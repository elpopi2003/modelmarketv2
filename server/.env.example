# Plantilla de configuración del servidor. Copia a server/.env (local) o define estas
# variables en Plesk (Node.js > Variables de entorno). Nunca subas valores reales.
NODE_ENV=development
PORT=3001
# Origen público de la app, sin barra final.
APP_URL=http://localhost:5173
# mysql://usuario:contraseña@host:3306/base_de_datos
DATABASE_URL=mysql://modelmarket:CAMBIAME@127.0.0.1:3306/modelmarket_dev
# Solo tests de integración: base de datos que se vacía en cada ejecución.
DATABASE_URL_TEST=mysql://modelmarket:CAMBIAME@127.0.0.1:3306/modelmarket_test
# Carpeta de la app compilada (vite build). Vacío en desarrollo (Vite sirve el frontend).
STATIC_DIR=
LOG_LEVEL=info
